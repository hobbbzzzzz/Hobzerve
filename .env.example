# Copy to .env.local for local development. Never commit real values.

# Public (browser-safe) Supabase settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by scripts/seed.mjs; never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seed script inputs (Decision 115). Passwords are set here at seed time only.
SEED_WORKSPACE_NAME=Docspert
SEED_MANAGER_EMAIL=ahmed.badr@docspert.com
SEED_MANAGER_NAME=Ahmed Badr
SEED_MANAGER_PASSWORD=
SEED_EMPLOYEE_EMAIL=abdelwahab.magdy@docspert.com
SEED_EMPLOYEE_NAME=Abdelwahab Magdy
SEED_EMPLOYEE_TITLE=Product Manager / Business Analyst
SEED_EMPLOYEE_PASSWORD=

# Local database URL for `npm run test:db` (a throwaway local Postgres, NOT the Supabase project)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/hobzerve_test

# Optional: first day the memberships count from (YYYY-MM-DD, Cairo). Defaults to today.
# Stage 2 prorates the weekly target from this date (Decision 110).
SEED_ACTIVE_FROM=

# ── Email (Stage 4) — Google Workspace SMTP. Server-only; set in Vercel, never commit. ──
# App password from the sending @docspert.com account (Google account → Security → App passwords; needs 2-Step Verification).
SMTP_USER=
SMTP_PASS=
# Optional overrides. EMAIL_FROM must be SMTP_USER itself or a "Send mail as" alias of that mailbox.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
EMAIL_FROM=
# Public URL of the app, used for links in emails
APP_URL=https://your-app.vercel.app
# Shared secret between the database and /api/email/dispatch (≥32 random characters). Also stored in the database with
#   select app.configure_email('https://your-app.vercel.app/api/email/dispatch', '<same secret>');
EMAIL_DISPATCH_SECRET=
